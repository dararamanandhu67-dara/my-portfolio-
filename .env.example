# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Nothing here is required for the site to build — the API degrades safely.
# ---------------------------------------------------------------------------

# --- Contact form (POST /api/contact) --------------------------------------
# Option A (recommended): Resend — https://resend.com (free tier available)
RESEND_API_KEY=
# Where messages are delivered
CONTACT_TO_EMAIL=dararamanandhu67@gmail.com
# Must be a verified sender/domain in Resend
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Option B: any JSON webhook (Formspree, Make, Zapier, Google Apps Script…)
# Used only when RESEND_API_KEY is empty.
CONTACT_WEBHOOK_URL=

# --- Resume (GET /api/resume) ----------------------------------------------
# PDF lives in public/resume/ and is served through the API with a proper
# download filename. Defaults match the values below.
RESUME_PATH=/resume/DARA_RAMANANDHU_Resume.pdf
RESUME_FILENAME=DARA_RAMANANDHU_Resume.pdf
# Public site URL, used by the function to fetch the file from the CDN
SITE_URL=https://ramanandhu.vercel.app

# --- Optional: persistent resume download counter ---------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Frontend ---------------------------------------------------------------
# Only set if the API is hosted on a different origin than the site
VITE_API_BASE=
